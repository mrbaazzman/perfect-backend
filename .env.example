# Copy this file to .env and fill in real values.
# Never commit your actual .env file.

# development | test | production
NODE_ENV=development

# Port the server listens on
PORT=3000

# Comma-separated allowed origins for CORS. "*" allows all (dev only).
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGIN=*

# SQLite database file. Both the Prisma CLI and the runtime adapter resolve the
# path against the project root (cwd), so "file:./prisma/dev.db" works for both.
DATABASE_URL="file:./prisma/dev.db"

# JWT secrets (generate long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_ACCESS_SECRET="change-me-please-generate-a-long-random-string"
JWT_REFRESH_SECRET="change-me-please-generate-a-different-long-random-string"

# Token lifetimes (jsonwebtoken format: 15m, 7d, ...)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (OAuth 2.0 Client ID from Google Cloud Console).
# The redirect URI must exactly match the "Authorized redirect URIs" registered in the console.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Frontend origin the OAuth callback redirects to after a successful login
FRONTEND_URL="http://localhost:5173"

# File uploads.
# local      = save to UPLOAD_DIR on disk, serve at UPLOAD_PUBLIC_BASE (dev).
# cloudinary = Cloudinary image/raw uploads (signed requests, no SDK).
#              Requires the three CLOUDINARY_* vars below.
# s3         = object storage (S3/R2) — NOT implemented yet, throws until wired.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_BASE=/uploads
UPLOAD_MAX_SIZE_MB=5
# Comma-separated whitelist of uploadable MIME types. SVG is deliberately
# excluded (it can carry scripts and would be served inline — XSS risk).
UPLOAD_ALLOWED_MIMES=image/png,image/jpeg,image/webp,image/gif,application/pdf,text/plain,application/json

# Cloudinary (required only when STORAGE_DRIVER=cloudinary).
# Cloud name + API key/secret: Cloudinary dashboard -> Settings -> API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
